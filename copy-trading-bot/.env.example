# Diese Datei NUR auf deinem eigenen Rechner/Server benutzen (heißt dann ".env").
# Bei GitHub Actions kommen diese Werte stattdessen in die GitHub-Secrets.

# Telegram (optional, aber empfohlen)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Wöchentliche KI-Analyse (optional) – Key von console.anthropic.com
ANTHROPIC_API_KEY=

# Passwort für das Web-Dashboard (optional, empfohlen)
DASHBOARD_PASSWORD=

# Nur für mode: live – Private Key der API-Wallet (kann handeln, aber NICHT abheben)
HL_PRIVATE_KEY=
# Adresse deines Hyperliquid-Hauptkontos
HL_ACCOUNT_ADDRESS=

# Nur für Memecoin LIVE-Modus: Private Key (Base58) einer EIGENEN Solana-Wallet nur für den Bot
# NIEMALS deine Haupt-Wallet! Nur so viel SOL drauf, wie du verlieren kannst.
SOLANA_PRIVATE_KEY=
